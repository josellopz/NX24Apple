From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@localhost>
Date: Mon, 2 Nov 2026 19:14:36 -0300
Subject: [PATCH] Declare Spanish for the fork shell localization catalogs

Upstream-Status: fork-only
Reason: Expose the Spanish catalog added by the NX24Apple fork in the packaged shell language list
Issue: josellopz/NX2Apple#1

---
 dm/ios/project-shell.yml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/dm/ios/project-shell.yml b/dm/ios/project-shell.yml
index 0f82937..5eefdf8 100644
--- a/dm/ios/project-shell.yml
+++ b/dm/ios/project-shell.yml
@@ -48,7 +48,7 @@ targets:
       path: Gen/Info.plist
       properties:
         CFBundleDisplayName: ${DM_SHELL_NAME}
-        CFBundleLocalizations: [en, de, fr, sv, zh-Hans]   # one per file of frontend/l10n (tools/l10n_shell_catalogs.py), iOS offers only the declared ones to the package bundles
+        CFBundleLocalizations: [en, de, es, fr, sv, zh-Hans]   # one per file of frontend/l10n (tools/l10n_shell_catalogs.py), iOS offers only the declared ones to the package bundles
         CFBundleVersion: $(CURRENT_PROJECT_VERSION)
         CFBundleShortVersionString: $(MARKETING_VERSION)
         UILaunchScreen: {}
