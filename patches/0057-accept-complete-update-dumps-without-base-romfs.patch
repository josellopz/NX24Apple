         with self.assertRaisesRegex(pack_dump.Error, 'not a base title ID'): pack_dump.scan(d)
         with self.assertRaisesRegex(pack_dump.Error, 'no base/exefs'): pack_dump.scan(self.dump.parent)
 
+    def test_update_only_romfs_keeps_its_version_and_never_advertises_base(self):
+        shutil.rmtree(self.dump / 'base/romfs')
+        self.assertTrue(nsp.dump_folder(self.dump))
+        app, fam = nsp.scan_dump(self.dump)
+        self.assertEqual(app, TID)
+        have = nsp.nsp_versions(fam, {})
+        self.assertEqual(have, {f'v{VER}': self.dump / f'updates/{VER}'})
+        self.assertNotIn('v0', have)
+        with self.assertRaisesRegex(nsp.BuildError, 'no NSP for update v0'):
+            nsp.pick_nsps(fam, have, ['v0'])
+        self.assertEqual(nsp.pick_nsps(fam, have, [f'v{VER}'])[f'v{VER}'][1], self.dump / f'updates/{VER}')
+
+    def test_missing_romfs_everywhere_is_not_a_dump(self):
+        shutil.rmtree(self.dump / 'base/romfs')
+        shutil.rmtree(self.dump / f'updates/{VER}/romfs')
+        self.assertFalse(nsp.dump_folder(self.dump))
+        with self.assertRaisesRegex(pack_dump.Error, 'complete updates'):
+            pack_dump.scan(self.dump)
+
     def test_packages_win_over_the_layout(self):
