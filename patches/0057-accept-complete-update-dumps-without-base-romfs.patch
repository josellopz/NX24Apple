diff --git a/scripts/build_ipa_from_nsp.py b/scripts/build_ipa_from_nsp.py
index e740af7..3792914 100755
--- a/scripts/build_ipa_from_nsp.py
+++ b/scripts/build_ipa_from_nsp.py
@@ -609,9 +609,18 @@ def vnum(ver):   # 'v655360' → 655360
     return int(ver[1:])
 
 
+def dump_versions(fam):
+    # Missing base RomFS is not v0. Preserve update numbers so profile derivation never
+    # pairs base executable code with an update's data or advertises an unavailable base.
+    out = {'v0': None} if (fam['base'] / 'romfs').is_dir() else {}
+    out.update((f'v{v}', p) for v, p in fam['updates'])
+    return out
+
+
 def nsp_versions(fam, builds):
     """The versions the folder holds: {version: its update NSP, or None for v0 (the base game alone)}. An update is known by the [v<N>] tag in its file name; a single update without one
     is taken for the newest update the profile registers (its build IDs are checked once extracted), and is left out when the profile registers none or other updates are there"""
+    if fam.get('dump'): return dump_versions(fam)
     out = {'v0': None}
     for v, p in fam['updates']:
         if v is not None: out[f'v{v}'] = p
diff --git a/scripts/pack_dump.py b/scripts/pack_dump.py
index 9e8b198..0806bf8 100644
--- a/scripts/pack_dump.py
+++ b/scripts/pack_dump.py
@@ -5,6 +5,7 @@
 #   base/exefs/ (main, main.npdm, sdk, rtld, subsdk*), base/romfs/
 #   updates/<version>/exefs/, updates/<version>/romfs/   (optional; <version> is the title version as a decimal number, 458752 = 0x70000)
 #   dlc/<DLC title ID>/<n>/romfs/   (optional; the DLC title ID in hex)
+# base/romfs may be absent when a complete update (exefs and romfs) is supplied.
 # An update's RomFS in such a dump is the patched RomFS (base + the update's BKTR patch, the tree the game sees), not a patch: it is packed on its own, never laid over the base
 # (Donkey Kong Bananza 458752 drops 42 base files, among them the Product.100 tables its Product.200 ones replace).
 # Writes, under the build folder (<dump folder>/<title ID>_build unless --work-dir names another):
@@ -53,12 +54,16 @@ def pack(src, img, say=print):
 
 
 def is_dump(folder):   # whether a folder has the layout above
-    return (folder / 'base/exefs/main.npdm').is_file() and (folder / 'base/romfs').is_dir()
+    if not (folder / 'base/exefs/main.npdm').is_file(): return False
+    if (folder / 'base/romfs').is_dir(): return True
+    updates = folder / 'updates'
+    return updates.is_dir() and any(p.is_dir() and p.name.isdigit() and int(p.name) > 0
+        and (p / 'exefs/main').is_file() and (p / 'exefs/main.npdm').is_file() and (p / 'romfs').is_dir() for p in updates.iterdir())
 
 
 def scan(dump):
     """What a dump folder holds: (title ID, {update version: its folder}, {DLC title ID: its RomFS folder})"""
-    if not is_dump(dump): raise Error(f'{dump}: no base/exefs/main.npdm and base/romfs')
+    if not is_dump(dump): raise Error(f'{dump}: no base/exefs/main.npdm with base/romfs or a complete updates/<version>/exefs and romfs')
     app = program_id(dump / 'base/exefs/main.npdm')
     if app & 0xFFF: raise Error(f'{dump}: base program ID {app:016X} is not a base title ID')
     vers = {int(p.name): p for p in (dump / 'updates').iterdir() if p.is_dir() and p.name.isdigit()} if (dump / 'updates').is_dir() else {}
