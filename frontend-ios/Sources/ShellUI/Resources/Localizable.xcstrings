    "Build this game again on your Mac and install it on this device. The Mac app checks every file while it builds, so the new copy is complete.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build this game again on your Mac and install it on this device. The Mac app checks every file while it builds, so the new copy is complete."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a compilar el juego en tu Mac e instálalo aquí. La app Mac comprueba todos los archivos durante la compilación para generar una copia completa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上重新构建此游戏并安装到本设备。Mac 应用构建时会检查每个文件，新副本是完整的。"
          }
        }
      }
    },
