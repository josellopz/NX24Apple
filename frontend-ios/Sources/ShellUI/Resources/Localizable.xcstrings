    "Games look for their data here. Keep one romfs.img per game in any folder inside. Each game is found by the image itself, so the folder names do not matter. Each game can also have a folder of its own.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Games look for their data here. Keep one romfs.img per game in any folder inside. Each game is found by the image itself, so the folder names do not matter. Each game can also have a folder of its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los juegos buscan sus datos aquí. Guarda un romfs.img por juego en cualquier subcarpeta. Se identifica por la imagen, sin importar el nombre de la carpeta. Cada juego también puede tener su propia carpeta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏会在这里查找游戏数据。请在其中的任意文件夹里为每个游戏放一个 romfs.img。应用会按镜像本身识别游戏，所以文件夹名称不限。每个游戏也可以单独指定文件夹。"
          }
        }
      }
    },
    "Games without a folder of their own save here. Choose the same iCloud Drive folder you use on your Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Games without a folder of their own save here. Choose the same iCloud Drive folder you use on your Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los juegos sin carpeta propia guardan aquí. Elige la misma carpeta de iCloud Drive que usas en el Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有单独指定文件夹的游戏会把存档保存在这里。请选择与 Mac 相同的 iCloud Drive 文件夹。"
          }
        }
      }
    },
